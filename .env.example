# SensOS compose environment (copy to .env — never commit secrets)

POSTGRES_PASSWORD=nvs-dev-password
NVS_JWT_SECRET=change-me-in-production-min-32-bytes!

# Optional LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434

# Observation Runtime backend: mock | claude_cli | ...
SENSOS_RUNTIME_BACKEND=mock
SENSOS_LOG_LEVEL=info
