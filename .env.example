############################################################
# Development example only.
#
# Copy this file to .env.
#
# Never commit real credentials.
#
# Never use these values in production.
############################################################

# Required for Compose. Replace CHANGE_ME with values you generate locally.
# Example generators (do not commit the output):
#   openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME
NVS_JWT_SECRET=CHANGE_ME

# Optional LLM providers — leave empty unless you inject your own keys.
# Never commit real API keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Local-only helper URL (not a secret). Safe for development templates.
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434

# Non-secret runtime knobs for local development.
SENSOS_RUNTIME_BACKEND=mock
SENSOS_LOG_LEVEL=info

# hekb-vnext's POST /experience governance key (a container-internal path,
# not a secret value itself -- the real key file is bind-mounted from
# ../hekb-vnext/devkeys/, generated once via `make hekb-devkeys`). Never
# the real Secure Enclave key -- dev/test signing only. GET /health does
# not require this, so `make up` succeeds without running `make
# hekb-devkeys` first; only writes via POST /experience will 403 until
# you do.
HEKB_AUDIT_PUBLIC_KEY_PATH=/app/keys/dev_public_key.raw
