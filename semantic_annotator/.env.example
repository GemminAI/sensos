# Copy to .env and fill in before `docker compose up`.
# See docs/handoff/HANDOFF_SA001_RUNPOD_BASELINE.md §8 (Known Risks).

# Exact HuggingFace model ID/checkpoint for the Gemma baseline.
# NOT YET CONFIRMED as of this handoff -- do not guess a value here.
GEMMA_MODEL_ID=

# HuggingFace token with the Gemma license accepted on huggingface.co.
# A missing/expired token fails during model download, not at request
# time -- confirm this works before provisioning the pod.
HF_TOKEN=
