{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sensos:contracts/nvs/token-temporal/0.1.0",
  "title": "nvs.token-temporal (payload) 0.1.0 確定 — LLM が処理したトークン列の時間軸（入力区間と生成区間。ID 列は Blob）",
  "description": "親は nvs.hidden-trajectory の観測。位置は保存せず、input は [0, n_in)、generated は [n_in, n_in+n_gen) と導出する。ids の中身（sha256・長さ・非負）、n と shape の一致、親との整合、segment_id と axis_id の再計算、区間の順序、producer 名は Gate が確かめる（スキーマは表せない）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "axis_id",
    "model_build_id",
    "tokenizer_sha256",
    "chat_template_sha256",
    "segments"
  ],
  "properties": {
    "axis_id": {
      "$ref": "#/$defs/sha256hex"
    },
    "model_build_id": {
      "type": "string",
      "minLength": 1
    },
    "tokenizer_sha256": {
      "$ref": "#/$defs/sha256hex"
    },
    "chat_template_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256hex"
        }
      ]
    },
    "segments": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "n",
            "segment_id",
            "ids"
          ],
          "properties": {
            "origin": {
              "const": "input"
            },
            "n": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "segment_id": {
              "$ref": "#/$defs/sha256hex"
            },
            "ids": {
              "$ref": "sensos:contracts/common/blob/0.7.0#/$defs/intBlob"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "n",
            "segment_id",
            "ids"
          ],
          "properties": {
            "origin": {
              "const": "generated"
            },
            "n": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "segment_id": {
              "$ref": "#/$defs/sha256hex"
            },
            "ids": {
              "$ref": "sensos:contracts/common/blob/0.7.0#/$defs/intBlob"
            }
          }
        }
      ],
      "items": false,
      "x-sensos-ordered": true
    }
  },
  "$defs": {
    "sha256hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
